/*
 * Genome settings.
 *   keep_chroms : nuclear chromosomes kept for peak calling (drops chrM, chloroplast, unplaced/alt contigs)
 *   macs_gsize  : MACS3 effective genome size (-g)
 * Chromosome names match the FASTA produced by scripts/build_index.sh.
 */
params {
    genomes {
        'hg38' {
            species     = 'Homo sapiens'
            keep_chroms = 'chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chr20 chr21 chr22 chrX chrY'
            macs_gsize  = 'hs'
        }
        'mm10' {
            species     = 'Mus musculus'
            keep_chroms = 'chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chrX chrY'
            macs_gsize  = 'mm'
        }
        'mm39' {
            species     = 'Mus musculus'
            keep_chroms = 'chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chrX chrY'
            macs_gsize  = 'mm'
        }
        'dm6' {
            species     = 'Drosophila melanogaster'
            keep_chroms = 'chr2L chr2R chr3L chr3R chr4 chrX chrY'
            macs_gsize  = 'dm'
        }
        'tair10' {
            species     = 'Arabidopsis thaliana'
            keep_chroms = 'Chr1 Chr2 Chr3 Chr4 Chr5'
            // MACS3 has no built-in shortcut for Arabidopsis; ~119 Mb assembly
            macs_gsize  = '1.19e8'
        }
    }
}
